# =====================================================================
# WAJIB DIUBAH SEBELUM DEPLOY KE INTERNET
# ---------------------------------------------------------------------
#   APP_ENV=production          (nilai "local" membuat CSP memuat origin
#                                dev server dan mematikan sebagian proteksi)
#   APP_DEBUG=false             (true membocorkan stack trace, isi .env,
#                                kredensial database, dan APP_KEY ke publik)
#   SESSION_SECURE_COOKIE=true  (wajib bila diakses lewat HTTPS/tunnel)
#   DB_PASSWORD / DB_ROOT_PASSWORD  -> ganti, jangan pakai nilai contoh
#   CORS_ALLOWED_ORIGINS        -> domain frontend, jangan dikosongkan
#   REDLINE_EXTRA_HOSTS         -> host tunnel Cloudflare
# Nilai di bawah ini disetel untuk pengembangan lokal.
# =====================================================================

APP_NAME="Redline Komputer"
APP_ENV=local
APP_TIMEZONE=Asia/Jakarta
AUTH_MODEL=App\Models\Pegawai
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=redline
DB_USERNAME=redline
DB_PASSWORD=redline_secret
DB_ROOT_PASSWORD=root_secret

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Redline (SIRC) ---
REDLINE_WA_NUMBER=6285640203069
REDLINE_STORE_NAME="Redline Komputer"

REDLINE_PUBLIC_HOST=localhost
REDLINE_STAFF_HOST=karyawan.localhost
REDLINE_ADMIN_HOST=admin.localhost

# Host tambahan yang dipercaya selain ketiga di atas (dipisah koma).
# Di produksi trustHosts TIDAK lagi memakai wildcard, jadi domain tunnel
# Cloudflare harus didaftarkan di sini.
REDLINE_EXTRA_HOSTS=

# Origin browser yang boleh memanggil /api/v1 (dipisah koma).
# Kosong = hanya APP_URL. Wildcard '*' sudah tidak dipakai lagi.
CORS_ALLOWED_ORIGINS=

# Masa berlaku token API dalam hari.
REDLINE_TOKEN_TTL_DAYS=30
